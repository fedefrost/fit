generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  male
  female
  other
}

// Nivel de actividad física; multiplica el gasto calórico basal (ver lib/nutrition.ts).
enum ActivityLevel {
  sedentary // poco o nada de ejercicio
  light // 1-3 días por semana
  moderate // 3-5 días por semana
  active // 6-7 días por semana
  very_active // entrenamiento intenso o trabajo físico
}

model Profile {
  id            Int           @id @default(autoincrement())
  weight        Float // kg
  height        Float // cm
  age           Int // años
  sex           Sex
  activityLevel ActivityLevel @default(sedentary)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  foods         ProfileFood[]
  dietPlan      DietPlan?
  equipment     ProfileEquipment[]
  workoutDays   WorkoutDay[]

  @@map("profiles")
}

enum FoodCategory {
  vegetables
  fruits
  legumes
  plant_proteins
  grains
  meat
  poultry
  eggs
  fish_seafood
  dairy
  dairy_alternatives
  nuts_seeds
  herbs_spices
  oils_fats
  sweets
  condiments
  beverages
}

// Catálogo de ingredientes. Es de solo lectura para la app: se carga con migraciones
// (ver prisma/migrations/*_food_catalog) y no tiene endpoints para editarlo.
model Food {
  id       Int                @id @default(autoincrement())
  slug     String             @unique // identificador estable, en inglés, para futuras migraciones del catálogo
  category FoodCategory
  nameEs   String
  nameEn   String
  profiles ProfileFood[]
  recipes  RecipeIngredient[]

  @@map("foods")
}

enum FoodPreference {
  preferred // le gustaría que aparezca más en su dieta
  rejected // no debe aparecer (gusto o salud)
}

// Un alimento puede estar en una sola lista por perfil (la clave primaria lo garantiza).
model ProfileFood {
  profileId  Int
  foodId     Int
  preference FoodPreference
  createdAt  DateTime       @default(now())
  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  food       Food           @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([profileId, foodId])
  @@index([foodId])
  @@map("profile_foods")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum RecipeUnit {
  g
  ml
  unit
  tbsp // cucharada
  tsp // cucharadita
  slice
  pinch
}

// Catálogo de recetas. Igual que Food: solo lectura, se carga con migraciones
// (ver prisma/migrations/*_recipe_catalog).
model Recipe {
  id          Int                @id @default(autoincrement())
  slug        String             @unique
  nameEs      String
  nameEn      String
  summaryEs   String // resumen de la preparación
  summaryEn   String
  mealTypes   MealType[] // en qué comidas puede usarse
  calories    Int // kcal por porción
  waterMl     Int                @default(0) // hidratación que aporta por porción
  ingredients RecipeIngredient[]
  dietMeals   DietMeal[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId Int
  foodId   Int
  quantity Float // por porción, en `unit`
  unit     RecipeUnit
  position Int // orden en la lista
  recipe   Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food     Food       @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([recipeId, foodId])
  @@index([foodId])
  @@map("recipe_ingredients")
}

// Dieta de la semana en curso. Un perfil tiene como máximo una: al generar la de otra
// semana se reemplaza (no se guarda historial).
model DietPlan {
  id        Int        @id @default(autoincrement())
  profileId Int        @unique
  weekStart DateTime   @db.Date // lunes de la semana
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  meals     DietMeal[]

  @@map("diet_plans")
}

enum MealSlot {
  breakfast
  lunch
  dinner
  extra // agregada por el usuario (colaciones, aperitivos...)
}

model DietMeal {
  id        Int      @id @default(autoincrement())
  planId    Int
  date      DateTime @db.Date
  slot      MealSlot
  recipeId  Int
  servings  Float // porciones; las calorías y el agua se escalan con esto
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  plan      DietPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([planId, date])
  @@index([recipeId])
  @@map("diet_meals")
}

// ---------- Rutina ----------

enum EquipmentLocation {
  home
  gym
}

// Catálogo de máquinas y herramientas. Solo lectura, se carga con migraciones
// (ver prisma/migrations/*_exercise_catalog).
model Equipment {
  id        Int                 @id @default(autoincrement())
  slug      String              @unique
  nameEs    String
  nameEn    String
  profiles  ProfileEquipment[]
  exercises ExerciseEquipment[]

  @@map("equipment")
}

// Qué tiene el perfil en casa y en el gimnasio. A diferencia de los alimentos, un mismo
// equipo puede estar en los dos lugares.
model ProfileEquipment {
  profileId   Int
  equipmentId Int
  location    EquipmentLocation
  createdAt   DateTime          @default(now())
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  equipment   Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([profileId, equipmentId, location])
  @@index([equipmentId])
  @@map("profile_equipment")
}

enum Muscle {
  legs
  biceps
  triceps
  glutes
  chest
  back
  abs
  shoulders
  general // cardio y movilidad: no dependen del músculo elegido (calentamiento)
}

enum ExerciseMeasure {
  time // minutos
  reps // series × repeticiones
  reps_weight // series × repeticiones × kg
}

// Catálogo de ejercicios. Solo lectura, se carga con migraciones.
// Las prescripciones base son para un nivel intermedio; lib/exercise.ts las ajusta al perfil.
model Exercise {
  id             Int                 @id @default(autoincrement())
  slug           String              @unique // también nombra la animación: /exercises/<slug>.png|.gif
  nameEs         String
  nameEn         String
  instructionsEs String
  instructionsEn String
  muscle         Muscle
  measure        ExerciseMeasure
  met            Float // equivalente metabólico (Compendium of Physical Activities)
  baseMinutes    Float? // measure = time
  baseReps       Int? // measure = reps | reps_weight
  secondsPerRep  Float               @default(3) // para estimar la duración de las series
  loadFactor     Float? // peso sugerido = loadFactor × peso corporal (intermedio)
  highImpact     Boolean             @default(false) // saltos/carrera: no se recomiendan con obesidad o 65+
  equipment      ExerciseEquipment[] // todo lo necesario; vacío = peso corporal
  entries        WorkoutExercise[]

  @@map("exercises")
}

model ExerciseEquipment {
  exerciseId  Int
  equipmentId Int
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
  @@map("exercise_equipment")
}

// Un día de entrenamiento: dónde se entrena y qué se hizo. Como la dieta, solo se guarda la
// semana en curso: al registrar un día se borran los de semanas anteriores.
model WorkoutDay {
  id        Int               @id @default(autoincrement())
  profileId Int
  date      DateTime          @db.Date
  location  EquipmentLocation
  muscles   Muscle[] // los elegidos al generar (hasta 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries   WorkoutExercise[]

  @@unique([profileId, date])
  @@map("workout_days")
}

enum WorkoutSource {
  planned // generado
  extra // añadido por el usuario
}

model WorkoutExercise {
  id         Int           @id @default(autoincrement())
  dayId      Int
  exerciseId Int
  source     WorkoutSource
  minutes    Float?
  sets       Int?
  reps       Int?
  weightKg   Float?
  done       Boolean       @default(false)
  createdAt  DateTime      @default(now())
  day        WorkoutDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise   Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([dayId])
  @@index([exerciseId])
  @@map("workout_exercises")
}
